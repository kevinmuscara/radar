{
  "name": "radar",
  "version": "1.0.0",
  "description": "Teacher friendly focused status dashboard for tracking the health of digital resources and infrastructure in one place.",
  "main": "index.js",
  "scripts": {
    "start": "npm run build:css && node index.js",
    "dev": "PORT=3000 HOST=0.0.0.0 node .",
    "prod": "NODE_ENV=production node index.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmuscara/radar.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kevinmuscara/radar/issues"
  },
  "homepage": "https://github.com/kevinmuscara/radar#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "memorystore": "^1.6.7",
    "multer": "^2.0.2",
    "path": "^0.12.7",
    "puppeteer": "^24.40.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2"
  }
}
